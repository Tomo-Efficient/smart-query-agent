# 复制为 .env 后填写；不填也能跑（离线模板模式，用于演示链路与安全拦截）
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 可选：接入向量召回（留空则只用 BM25）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# 试点模式：登录、数据域、审计、多轮
NL2SQL_AUTH=on              # off = 公开演示（不登录，全量数据域）
NL2SQL_SEED_USERS=on        # 首次启动写入 admin/zhang/li 三个演示账号
NL2SQL_SESSION_TTL=12       # 会话有效期（小时）
NL2SQL_DAILY_QUOTA=200      # 每个账号每天的提问额度
NL2SQL_APP_DB=data/app.db   # 账号、会话、审计（与只读业务库分开）
